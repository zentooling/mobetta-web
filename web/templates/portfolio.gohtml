{{ template "header.gohtml" . }}

<main class="flex-shrink-0">

    {{ template "messages.gohtml" . }}

    <div class="container mt-5">
        <h2 class="text-center">Stock Portfolio Dashboard</h2>
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <h5 class="card-title">Total Value</h5>
                        <p class="display-6 text-primary">$28,450</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <h5 class="card-title">Today's Change</h5>
                        <p class="text-success">+2.3%</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <h5 class="card-title">Portfolio Return</h5>
                        <p class="text-primary">+14.7%</p>
                    </div>
                </div>
            </div>
        </div>
        <div id=chart-container class="row mt-4">
            <!-- The go-echarts HTML includes its own <div> and <script> tags -->
            {{ .Element }}
            {{ .Script }}

        </div>

        <div></div>

        <div class="container mt-5">
            <h3 class="text-center" >Holdings</h3>

            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                    <tr>
                        <th>Stock</th>
                        <th>Rank</th>
                        <th>Close</th>
                        <th>Volatility</th>
                        <th>Pct Alloc</th>
                        <th>Num Shares</th>
                        <th>Cost</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{range .Holdings}}
                        <tr>
                            <td>{{.Ticker}}</td>
                            <td>{{ printf "%.2f"  .Rank}}</td>
                            <td>{{ printf "$%.2f"  .Close}}</td>
                            <td>{{ printf "%.4f"  .Volatility}}</td>
                            <td>{{ printf "%.3f"  .PctAlloc}}</td>
                            <td style="text-align: center">{{ printf "%.2f"  .NumShares}}</td>
                            <td style="text-align: center">{{ printf "$%.2f" .Cost}}</td>
                        </tr>
                    {{end}}

                    </tbody>
                </table>
            </div>
        </div>
    </div>

</main>

{{ template "footer.gohtml" . }}
